{
  "expo": {
    "name": "MacroMind",
    "slug": "MacroMind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "macromind",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.macromind.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.macromind.app",
      "adaptiveIcon": {
        "backgroundColor": "#F7F4EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "MacroMind necesita acceso a tus fotos para analizar comidas.",
          "cameraPermission": "MacroMind necesita usar la cámara para analizar comidas.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F7F4EE"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
