# Demo local: keeps the app usable without a backend or API key.
EXPO_PUBLIC_DEMO_MODE=true

# For real analysis set false and use the computer LAN IP from the phone.
# Example: http://192.168.1.25:8787
EXPO_PUBLIC_ANALYSIS_API_URL=http://192.168.1.25:8787

# Production example (use the real HTTPS URL of your deployed backend):
# EXPO_PUBLIC_DEMO_MODE=false
# EXPO_PUBLIC_ANALYSIS_API_URL=https://api.example.com
